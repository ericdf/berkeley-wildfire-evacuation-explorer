.DS_Store
# Large, reproducible downloads. Re-fetch with tools/fetch-city-layers.mjs;
# the report PDFs come from the Wayback Machine URLs in SOURCE_NOTES.md.
data/raw/city/
data/raw/docs/*.pdf
# Aerial imagery clips (public City service): large; keep derived counts only.
data/raw/imagery/
# Claude Code worktrees and local settings
.claude/

# Street-widening screening: block-group ACS values (aggregates only); parcel and building geometry is never saved.
data/raw/widening/
# Egress candidates: Overpass responses and lookups (tools/egress-candidates.mjs); re-fetched on demand. Parcel geometry is never saved.
data/raw/egress/
